# =================================================================
# Credenciales para MongoDB
# =================================================================
MONGO_INITDB_ROOT_USERNAME=usuario
MONGO_INITDB_ROOT_PASSWORD=contraseña

# URL de conexión utilizada por la aplicación (modo local, fuera de Docker)
MONGO_URL=mongodb://usuario:contraseña@localhost:27017

# Bases de datos
MONGO_DB_DEV=pdf_extractor_dev
MONGO_DB_TEST=pdf_extractor_test

# Puerto de la host para exponer MongoDB (mapeo de docker-compose)
MONGO_PORT=27017

# =================================================================
# Document Service - Infraestructura (Paso 1: Redis + Traefik)
# =================================================================

# Puerto de la host para acceder a la API directamente (fuera del gateway)
APP_PORT=8000

# Dominio que Traefik usa para enrutar el puerto 80 hacia document-service
# Regla resultante: Host(`<DOMAIN>`)
DOMAIN=localhost

# Puerto del dashboard de Traefik (solo desarrollo, http://localhost:8081)
TRAEFIK_DASHBOARD_PORT=8081

# Redis broker
# OJO: fuera de Docker (uvicorn en local) usá localhost.
# Dentro de docker-compose.yml se inyecta REDIS_HOST=redis_broker,
# sobrescribiendo este valor: las variables de entorno reales tienen
# prioridad sobre el archivo .env (12-Factor App).
REDIS_HOST=localhost
# Puerto DENTRO de la red Docker / de conexión de la aplicación
REDIS_PORT=6379
# Puerto de la host para debug con redis-cli (mapeo de docker-compose)
REDIS_HOST_PORT=6379
# Base de datos lógica de Redis (0-15)
REDIS_DB=0
# Nombre de la cola de tareas de extracción de texto
REDIS_QUEUE_KEY=pdf:extract_text

# Tamaño máximo de archivo permitido para subida (MB)
MAX_FILE_SIZE_MB=5

# Nivel de logging
LOG_LEVEL=INFO